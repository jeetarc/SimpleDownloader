<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:orientation="vertical"
	android:layout_width="match_parent"
	android:layout_height="match_parent">
	<LinearLayout
		android:id="@+id/linear1"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:orientation="vertical">
		<RadioGroup
			android:id="@+id/radioGroup"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:gravity="center_horizontal|center_vertical"
			android:orientation="horizontal">
			<RadioButton
				android:id="@+id/radioMediaStore"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginRight="4dp"
				android:padding="8dp"
				android:text="MediaStore"
				android:textSize="12sp"
				android:textStyle="bold" />
			<RadioButton
				android:id="@+id/radioTreeUri"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginLeft="4dp"
				android:layout_marginRight="4dp"
				android:padding="8dp"
				android:text="TreeURI"
				android:textSize="12sp"
				android:textStyle="bold" />
			<RadioButton
				android:id="@+id/radioFolderPath"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginLeft="4dp"
				android:padding="8dp"
				android:text="FolderPath"
				android:textSize="12sp"
				android:textStyle="bold" />
		</RadioGroup>
		<ScrollView
			android:id="@+id/vscroll2"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:layout_gravity="center_horizontal">
			<LinearLayout
				android:id="@+id/linear3"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:paddingLeft="16dp"
				android:paddingRight="16dp"
				android:orientation="vertical"
				android:layout_gravity="center_horizontal">
				<LinearLayout
					android:id="@+id/linearDestination"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginBottom="20dp"
					android:padding="10dp"
					android:orientation="vertical">
					<TextView
						android:id="@+id/headingDestination"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:layout_marginBottom="3dp"
						android:text="Output Destination"
						android:textSize="11sp"
						android:textColor="@color/md_theme_primary" />
					<TextView
						android:id="@+id/txtDestination"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:text="Click here to select a download folder via SAF"
						android:textSize="13sp"
						android:textStyle="bold"
						android:textColor="@color/md_theme_primary"
						android:ellipsize="end"
						android:maxLines="2" />
				</LinearLayout>
				<com.google.android.material.textfield.TextInputLayout
					android:id="@+id/textinputlayout1"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginBottom="20dp"
					app:endIconMode="clear_text">
					<com.google.android.material.textfield.TextInputEditText
						android:id="@+id/txtInputUrl"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:gravity="center_vertical"
						android:textSize="14sp"
						android:hint="Enter a file URL"
						android:textColorHint="@color/colorGray"
						android:layout_gravity="center_vertical"
						android:maxLines="2" />
				</com.google.android.material.textfield.TextInputLayout>
				<com.google.android.material.textfield.TextInputLayout
					android:id="@+id/textinputlayout2"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginBottom="20dp"
					app:endIconMode="clear_text">
					<com.google.android.material.textfield.TextInputEditText
						android:id="@+id/txtInputHeaders"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:gravity="center_vertical"
						android:textSize="14sp"
						android:hint="Enter Headers in JSON format (optional)"
						android:textColorHint="@color/colorGray"
						android:layout_gravity="center_vertical"
						android:maxLines="2" />
				</com.google.android.material.textfield.TextInputLayout>
				<com.google.android.material.button.MaterialButton
					android:id="@+id/btnStartDownload"
					android:layout_width="200dp"
					android:layout_height="wrap_content"
					android:layout_marginBottom="40dp"
					android:padding="8dp"
					android:gravity="center_horizontal|center_vertical"
					android:text="Start Download"
					android:textSize="14sp"
					android:textStyle="bold"
					android:layout_gravity="center_horizontal|center_vertical" />
				<TextView
					android:id="@+id/textview2"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_marginBottom="10dp"
					android:text="Test Files (click to paste):"
					android:textSize="14sp"
					android:textStyle="bold"
					android:textColor="@color/colorGray" />
				<LinearLayout
					android:id="@+id/linearUrl1"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginBottom="10dp"
					android:padding="10dp"
					android:orientation="vertical">
					<TextView
						android:id="@+id/headingUrl1"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:layout_marginBottom="3dp"
						android:text="MP4 File URL - 68.8MB"
						android:textSize="12sp"
						android:textColor="@color/md_theme_primary" />
					<TextView
						android:id="@+id/url1"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:text="URL here"
						android:textSize="13sp"
						android:textStyle="bold"
						android:textColor="@color/md_theme_primary"
						android:ellipsize="end"
						android:maxLines="2" />
				</LinearLayout>
				<LinearLayout
					android:id="@+id/linearUrl2"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginBottom="10dp"
					android:padding="10dp"
					android:orientation="vertical"
					android:ellipsize="end">
					<TextView
						android:id="@+id/headingUrl2"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:layout_marginBottom="3dp"
						android:text="MP3 File URL - 4.3MB"
						android:textSize="12sp"
						android:textColor="@color/md_theme_primary" />
					<TextView
						android:id="@+id/url2"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:text="URL here"
						android:textSize="13sp"
						android:textStyle="bold"
						android:textColor="@color/md_theme_primary"
						android:ellipsize="end"
						android:maxLines="2" />
				</LinearLayout>
				<LinearLayout
					android:id="@+id/linearUrl3"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:padding="10dp"
					android:orientation="vertical">
					<TextView
						android:id="@+id/headingUrl3"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:layout_marginBottom="3dp"
						android:text="JPG File URL - 1.1MB"
						android:textSize="12sp"
						android:textColor="@color/md_theme_primary" />
					<TextView
						android:id="@+id/url3"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:text="URL here"
						android:textSize="13sp"
						android:textStyle="bold"
						android:textColor="@color/md_theme_primary"
						android:ellipsize="end"
						android:maxLines="2" />
				</LinearLayout>
			</LinearLayout>
		</ScrollView>
	</LinearLayout>
</LinearLayout>
